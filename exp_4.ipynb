      "source": [
        "import numpy as np\n",
        "\n",
        "# Current weight vector\n",
        "W = np.array([0.7, 0.5, 0.9])\n",
        "\n",
        "# Gradient vector\n",
        "G = np.array([0.2, 0.1, 0.3])\n",
        "\n",
        "# Learning rate\n",
        "learning_rate = 0.1\n",
        "\n",
        "# Update weights\n",
        "W_new = W - learning_rate * G\n",
        "\n",
        "# Display updated weights\n",
        "print(\"Updated Weight Vector:\")\n",
        "print(W_new)\n"
      ]
    }
  ]
}