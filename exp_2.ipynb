        "import numpy as np\n",
        "\n",
        "X = np.array([4, 6, 8])\n",
        "W = np.array([0.5, 0.3, 0.2])\n",
        "b = 2\n",
        "\n",
        "Y = np.dot(X, W) + b\n",
        "\n",
        "print(\"Predicted Student Performance:\", Y)"
      ]
    }
